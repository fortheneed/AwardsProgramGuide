   "title": "Types of Charms",
   "audiences": [
    "alumni"
   ],
   "intro": "Alumni can earn charms in two ways: through the big goals you are still chasing, and through the ways you give back as a volunteer.",
   "sections": [
    {
     "heading": "Major Targets – 200 tickets",
     "text": "Big life goals, like graduating, getting a job, or earning your driver’s license."
    },
    {
     "heading": "Attendance",
     "text": "Charms for coming to events as a volunteer, including Bronze, Silver, Gold, and 5 in a Row."
    },
    {
     "heading": "Service & Leadership",
     "text": "Charms for giving your time and skills, like volunteering 100 hours, teaching, or leading a club."
    },
    {
     "heading": "Mentoring",
     "text": "Charms for mentoring, like being a Co-Mentor or having a Mentee."
    },
    {
     "heading": "Safety & Training",
     "text": "Background checks and trainings that keep everyone safe, like Mandated Reporter and CPR Certified."
    },
    {
     "heading": "Connection",
     "text": "Charms for connecting online and referring a new volunteer."
    }
