   "id": "how-tickets",
   "title": "How Charms Work",
   "audiences": [
    "arrows",
    "alumni"
   ],
   "numbered": true,
   "intro": "Welcome! A charm is how we celebrate something you've done. Every achievement in this guide has its own charm, and each page that follows shows what it takes to earn it.",
   "sections": [
    {
     "heading": "Pick a goal",
     "text": "Look through the Table of Contents. Each page is one charm, or a small group of charms, with the steps to earn it."
    },
    {
     "heading": "Do the work",
     "text": "Follow the steps on the page. Ask a staff member or volunteer anytime you have a question."
    },
    {
     "heading": "Report it",
     "text": "When you have unlocked an achievement, turn in the small sheet at the check-in table. The Reporting Your Achievements page has the details."
    },
    {
     "heading": "Collect your charm and tickets",
     "text": "Once an achievement is recorded, the charm is yours, along with any tickets listed at the top of its page."
    },
    {
     "heading": "Good to know",
     "text": "A few charms, like 5 in a Row, are counted for you automatically. You don't need to report those.",
     "highlight": true
    }
   ]
  },
